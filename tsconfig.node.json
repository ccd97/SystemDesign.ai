{
  "compilerOptions": {
    "composite": true,
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "electron"]
  },
  "include": ["vite.config.ts", "electron", "src/entities/settings/model/types.ts", "src/entities/canvas/model/types.ts", "src/entities/recording/model/types.ts", "src/shared/types/**/*"]
}
